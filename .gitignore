# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated preview (regenerate via docs/marketing/console/gen-messages-preview.ts)
docs/marketing/console/messages-preview.html

# Supabase CLI local state (contains project-ref / pooler-url — must not be committed)
supabase/.temp/

# Πρόχειρα αρχεία δοκιμής στη ρίζα. Το «npx tsx -e» και τα σενάρια ελέγχου
# αφήνουν πίσω τους αρχεία σαν «__gen.ts»· ένα από αυτά μπήκε κάποτε σε commit.
__gen*.ts
*.tmp.ts
*.tmp.cjs
.e2e-money/
.perf-bench/
.perf-form/
# Οι αναρτήσεις είναι ΠΑΡΑΓΟΜΕΝΕΣ και γερνούν την ίδια μέρα: ο μετρητής τους
# αλλάζει κάθε πρωί. Ο,τι δεσμεύεται σε αποθετήριο πρέπει να είναι αληθινό όταν
# διαβαστεί, όχι όταν γράφτηκε.
docs/marketing/posts/*
!docs/marketing/posts/.gitkeep
# Το ίδιο και οι καταγραφές οθόνης: παράγονται με μία εντολή, ζυγίζουν
# μεγαμπάιτ, και γερνούν τη στιγμή που αλλάζει η σελίδα που δείχνουν.
docs/marketing/reels/*
!docs/marketing/reels/.gitkeep
.e2e-signup/
