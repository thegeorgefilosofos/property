# ─────────────────────────────────────────────────────────────────────────────
# PropertyOS — local environment variables
#
# Copy this file to `.env.local` and fill in the values below. `.env.local` is
# gitignored and must never be committed. These are the ONLY variables the web app
# reads; all privileged secrets (Supabase service-role key, Resend, cron secrets,
# messaging tokens) live in the Supabase Edge Function environment, not here.
#
# After editing: stop the dev server (Ctrl+C) and re-run `npm run dev`.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project — Project Settings → API
# The anon/public key is safe to expose to the browser; it is gated by Row-Level
# Security. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # anon / public key (starts with eyJ)

# AI assistant — server-side only (used by app/api/anthropic).
# Get a key from the Anthropic Console. Leave blank to run the app without the
# assistant. This value is read only on the server and never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...
