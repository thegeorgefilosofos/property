# ─────────────────────────────────────────────────────────────────────────────
# PropertyOS — local environment variables
#
# Copy this file to `.env.local` and fill in the values below. `.env.local` is
# gitignored and must never be committed. These are the ONLY variables the web app
# reads; all privileged secrets (Supabase service-role key, Resend, cron secrets,
# messaging tokens) live in the Supabase Edge Function environment, not here.
#
# After editing: stop the dev server (Ctrl+C) and re-run `npm run dev`.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project — Project Settings → API
# The anon/public key is safe to expose to the browser; it is gated by Row-Level
# Security. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # anon / public key (starts with eyJ)

# AI assistant — server-side only (used by app/api/anthropic).
# Get a key from the Anthropic Console. Leave blank to run the app without the
# assistant. This value is read only on the server and never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Error tracking (optional, free) — Sentry DSN. Leave BLANK to disable entirely:
# lib/observability/report.ts is a no-op without it (no bundle cost, no network).
# When set, unhandled render errors and reported exceptions are sent to Sentry.
# For the edge functions, set SENTRY_DSN in the Supabase function env instead.
NEXT_PUBLIC_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# Χρέωση συνδρομής — Lemon Squeezy (merchant of record)
#
# ΟΣΟ ΛΕΙΠΕΙ ΕΣΤΩ ΜΙΑ ΑΠΟ ΤΙΣ ΤΡΕΙΣ, Η ΧΡΕΩΣΗ ΕΙΝΑΙ ΚΛΕΙΣΤΗ ΠΑΝΤΟΥ: δεν
# εμφανίζεται κουμπί πληρωμής, και οι Οροι, η Πολιτική απορρήτου, η σελίδα
# εμπιστοσύνης, το FAQ και το μητρώο υπεργολάβων λένε ότι δεν γίνεται χρέωση.
# Οι ίδιες τρεις ανοίγουν και τα έξι μαζί (lib/legal/billingWords.ts).
#
# ΚΑΙ ΟΙ ΤΡΕΙΣ ΜΑΖΙ, ΓΙΑΤΙ ΤΟ ΜΙΣΟ ΕΙΝΑΙ ΧΕΙΡΟΤΕΡΟ ΑΠΟ ΤΟ ΤΙΠΟΤΑ. Με ζωντανό
# ταμείο και ξεχασμένο χάρτη παραλλαγών, ο πελάτης πληρώνει και ο webhook
# απαντά σφάλμα σε κάθε γεγονός: χρεωμένοι πελάτες χωρίς πακέτο.

# Το κλειδί του API. Το χρειάζονται και οι τρεις διαδρομές: το ταμείο (που
# δημιουργείται ανά πάτημα, όχι στατικός σύνδεσμος), η πύλη διαχείρισης
# συνδρομής, και η αλλαγή πακέτου.
LEMON_SQUEEZY_API_KEY=

# Το κατάστημα. ΑΡΙΘΜΟΣ, όχι όνομα: Settings → Stores στον πίνακα του εμπόρου.
LEMON_STORE_ID=

# Ποια παραλλαγή δίνει ποιο πακέτο: variant:πακέτο:κύκλος, χωρισμένα με κόμμα.
# Ο ΙΔΙΟΣ χάρτης διαβάζεται και προς τις δύο κατευθύνσεις — το ταμείο βρίσκει
# την παραλλαγή από το πακέτο, ο webhook το πακέτο από την παραλλαγή.
# Πακέτα: solo | owner | agency | office. Κύκλοι: monthly | annual.
# Παράδειγμα: 811223:solo:monthly,811224:solo:annual,811225:owner:monthly
LEMON_VARIANTS=

# Το μυστικό υπογραφής του webhook. Το ΟΡΙΖΕΙΣ ΕΣΥ στον πίνακα του εμπόρου και
# το αντιγράφεις εδώ. Χωρίς αυτό ΔΕΝ γίνεται δεκτό κανένα γεγονός.
# Γεγονότα: όλα τα subscription_* πλην των subscription_payment_*.
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Ο κωδικός των δοκιμαστών της Beta. Εξαργυρώνεται ΜΕΣΑ στην εφαρμογή, από τον
# Λογαριασμό: καμία κάρτα, κανένα ταμείο, καμία συνδρομή στον έμπορο. Ο κάτοχος
# διαλέγει ελεύθερα οποιοδήποτε πακέτο, όσο συχνά θέλει.
#
# ΓΙΑΤΙ ΟΧΙ ΕΚΠΤΩΤΙΚΟΣ ΚΩΔΙΚΟΣ ΤΟΥ ΕΜΠΟΡΟΥ: η Lemon Squeezy ζητά στοιχεία κάρτας
# ακόμη και στα 0,00 €, οπότε ένας κωδικός 100% θα εμφάνιζε τη φόρμα αντί να τη
# γλιτώσει. Ο δοκιμαστής που κάνει χάρη δεν βγάζει την κάρτα του.
#
# ΟΣΟ ΜΕΝΕΙ ΚΕΝΟ, ΚΑΝΕΝΑΣ ΚΩΔΙΚΟΣ ΔΕΝ ΤΑΙΡΙΑΖΕΙ — ούτε το κενό πεδίο.
# Αλλάζει χωρίς deploy, και δεν φτάνει ποτέ στον περιηγητή.
TESTER_CODE=

# ── Η ΔΟΚΙΜΗ ΕΙΝΑΙ ΡΥΘΜΙΣΗ ΤΟΥ ΚΑΤΑΣΤΗΜΑΤΟΣ, ΟΧΙ ΤΟΥ ΚΩΔΙΚΑ ────────────────
# Καθε παραλλαγή έχει «Subscription has free trial? → 30 ημέρες». Η κάρτα
# ζητείται στο ταμείο, καμία χρέωση δεν γίνεται, και η πρώτη χρέωση έρχεται
# την 31η ημέρα μόνη της.
#
# Η ΔΟΚΙΜΗ ΟΜΩΣ ΕΙΝΑΙ ΜΙΑ ΑΝΑ ΛΟΓΑΡΙΑΣΜΟ, ΚΑΙ ΑΥΤΟ ΤΟ ΚΡΙΝΕΙ Ο ΚΩΔΙΚΑΣ: κάθε
# επόμενο ταμείο του ίδιου λογαριασμού ζητά `skip_trial` από τον έμπορο. Χωρίς
# αυτό, ακύρωση τη δεύτερη ημέρα και ένα νέο πάτημα δίνουν καθαρές 30 ημέρες,
# ίδιο email, ίδια κάρτα, επ' άπειρον.

# Ρόλος υπηρεσίας της Supabase: παρακάμπτει ΟΛΗ την RLS και τον χρειάζεται μόνο
# ο webhook, που γράφει το πακέτο χωρίς συνδεδεμένο χρήστη. Ποτέ σε πελάτη.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Η διεύθυνση του ιστότοπου
#
# Από εδώ βγαίνουν τα canonical URLs, ο χάρτης, τα δομημένα δεδομένα και κάθε
# σύνδεσμος μέσα σε email. ΟΣΟ ΜΕΝΕΙ ΚΕΝΟ ισχύει η διεύθυνση του Vercel, που
# απαντά. Οταν αγοραστεί domain, αλλάζει ΜΟΝΟ εδώ (και το APP_URL στο
# περιβάλλον των συναρτήσεων άκρης).
#
# Μορφή: https://domain, χωρίς κάθετο στο τέλος, χωρίς διαδρομή. Οτιδήποτε
# άλλο αγνοείται και ισχύει η προεπιλογή.
NEXT_PUBLIC_SITE_URL=
